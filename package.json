{
  "name": "questrealm-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build:web && npm run build:api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "typecheck:api": "npm run typecheck --workspace=apps/api",
    "lint:web": "npm run lint --workspace=apps/web",
    "preview:web": "npm run preview --workspace=apps/web",
    "start": "npm run start:api",
    "start:api": "npm run start --workspace=apps/api",
    "test": "node --import ./tests/setup.mjs --import tsx --test tests/*.test.mjs apps/api/src/modules/auth/password.test.ts",
    "typecheck:serverless": "tsc --noEmit -p api/tsconfig.json",
    "check": "npm test && npm run lint:web && npm run typecheck:serverless && npm run build"
  },
  "keywords": [],
  "type": "commonjs"
}
